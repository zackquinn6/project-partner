# Optional: other Vite variables your app may use.
#
# Supabase (browser client): URL and anon/publishable key live in source at
#   src/integrations/supabase/publicClientConfig.ts
# so hosts without project env vars (e.g. Lovable) still build and run. RLS protects your data;
# never put service_role or other server secrets in the frontend repo.

# VITE_AUTH_EMAIL_REDIRECT_URL=https://your-production-domain.com/auth

# Edge Function secrets (Supabase Dashboard → Edge Functions → Secrets), not Vite:
# PUBLIC_APP_URL=https://projectpartner.toolio.us
# STRIPE_WEBHOOK_SECRET=whsec_...
# CONTACT_INBOX=support@yourdomain.com
# STRIPE_PRICE_ID_PROJECTS=price_...
